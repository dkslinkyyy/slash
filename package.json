{
  "name": "slash-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "cra-template": "1.2.0",
    "crypto-js": "^4.2.0",
    "electron-fetch": "^1.9.1",
    "node-fetch": "^3.3.2",
    "nth-check": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "^5.0.1",
    "wait-on": "^8.0.1",
    "ws": "^8.18.0"
  },
  "main": "public/electron.js",
  "scripts": {
    "start": "concurrently \"BROWSER=none react-scripts start\" \"npm run electron-start\"",
    "react-start": "BROWSER=none react-scripts start",
    "electron-start": "wait-on http://localhost:3000 && electron .",
    "load-scripts": "react-scripts start",
    "build": "react-scripts build",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.appname",
    "productName": "YourApp",
    "files": [
      "build/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/assets/slash-logo-sm.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/assets/slash-logo-sm.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react-devtools": "^6.0.1",
    "react-router-dom": "^7.1.1",
    "tailwindcss": "^3.4.17"
  }
}
